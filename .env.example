# Copy this file to .env, then paste your two keys below — that's all you need to run this.

# Used for embeddings (src/embeddings.py)
OPENAI_API_KEY=sk-...

# Used for generating answers with Claude (src/llm_provider.py)
ANTHROPIC_API_KEY=sk-ant-...


# --- Everything below is optional. Each already has a sensible default in ---
# --- src/config.py, so you only need to uncomment/edit a line to override it. ---

# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# LLM_PROVIDER=anthropic          # or "ollama" to generate answers with a local model
# OLLAMA_MODEL=qwen3:1.7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192
# OLLAMA_MAX_TOKENS=1024
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=4096

# --- Answer engines (UI buttons: Claude API / LoRA Qwen + RAG / Plain Qwen); see docs/LOQA_QWEN_RAG_INTEGRATION.md ---
# LORA_QWEN_URL=http://127.0.0.1:8095          # local MLX service: distill/finetune/lora_server.py
# LORA_ADAPTER_NAME=lora_demo_qwen3_1.7b       # must match the service's --adapter-name, or the engine is refused
# LORA_ADAPTER_LABEL=Experimental LoRA Pilot — 30 examples
# LORA_BASE_MODEL=Qwen3-1.7B
# LORA_MAX_TOKENS=1600
# LORA_TIMEOUT=300
# ENGINE_MAX_RETRIES=1                          # retries after MALFORMED/TRUNCATED output, same for every engine
# ENGINE_ANSWER_INSTRUCTION=dataset             # "dataset" = distillation answer instruction for all engines; "none"
# EVIDENCE_CACHE_TTL_S=3600                     # how long frozen evidence is reused across engines
# ENGINE_TELEMETRY_PATH=data/telemetry/engine_requests.jsonl

# VECTOR_DB_PROVIDER=chroma
# CHROMA_PATH=db/chroma
# CHROMA_COLLECTION=legal_documents

# SQLITE_DB_PATH=db/nyayasetu.db

# CHUNK_TARGET_CHARS=1200
# CHUNK_OVERLAP_CHARS=150

# DEFAULT_TOP_K=5
# RETRIEVAL_CANDIDATE_K=15
# SEMANTIC_SCORE_THRESHOLD=0.35
# RERANK_ENABLED=true
# RERANK_STRATEGY=rrf             # rank fusion; "weighted" = previous 0.75 semantic + 0.25 word-overlap
# RRF_K=60
# MAX_CHUNKS_PER_DOCUMENT=1
# REFERENCE_LOOKUP_ENABLED=true   # "Section 140 of the NI Act", "IPC 420" -> exact statute sections
# MAPPING_LOOKUP_ENABLED=true     # add old/new-code counterparts from stored correspondences
# MAPPING_MAX_PER_REFERENCE=3

# LOG_LEVEL=INFO
