# Copy this file to .env, then paste your two keys below — that's all you need to run this.

# Used for embeddings (src/embeddings.py)
OPENAI_API_KEY=sk-...

# Used for generating answers with Claude (src/llm_provider.py)
ANTHROPIC_API_KEY=sk-ant-...


# --- Everything below is optional. Each already has a sensible default in ---
# --- src/config.py, so you only need to uncomment/edit a line to override it. ---

# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=4096

# VECTOR_DB_PROVIDER=chroma
# CHROMA_PATH=db/chroma
# CHROMA_COLLECTION=legal_documents

# SQLITE_DB_PATH=db/nyayasetu.db

# CHUNK_TARGET_CHARS=1200
# CHUNK_OVERLAP_CHARS=150

# DEFAULT_TOP_K=5
# RETRIEVAL_CANDIDATE_K=15
# SEMANTIC_SCORE_THRESHOLD=0.35
# RERANK_ENABLED=true
# MAX_CHUNKS_PER_DOCUMENT=2

# LOG_LEVEL=INFO
